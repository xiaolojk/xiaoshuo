# ============================================================
#  PixelLakeHeart 示例 Mod：黄金鲤鱼 gold_carp
#  ------------------------------------------------
#  把 0 号鱼（鲤鱼）的 16 色调色板整体改成金色系。
#
#  语法：palette <鱼编号0-9> <颜色索引0-15> r=红 g=绿 b=蓝
#  每条鱼自带 16 种颜色（索引 0~15），逐一覆盖即可换肤。
#  r/g/b 取值范围 0~255。
# ============================================================

palette 0 0  r=255 g=223 b=120
palette 0 1  r=255 g=215 b=90
palette 0 2  r=255 g=205 b=70
palette 0 3  r=250 g=200 b=60
palette 0 4  r=255 g=190 b=50
palette 0 5  r=250 g=180 b=45
palette 0 6  r=245 g=175 b=40
palette 0 7  r=255 g=160 b=35
palette 0 8  r=250 g=140 b=30
palette 0 9  r=245 g=135 b=25
palette 0 10 r=220 g=120 b=30
palette 0 11 r=255 g=100 b=15
palette 0 12 r=255 g=80  b=10
palette 0 13 r=210 g=60  b=5
palette 0 14 r=150 g=45  b=0
palette 0 15 r=100 g=30  b=0