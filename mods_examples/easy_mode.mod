# ============================================================
#  PixelLakeHeart 示例 Mod：轻松模式 easy_mode
#  ------------------------------------------------
#  用法：把本文件复制到 exe 同目录下的 mods/ 文件夹里即可，
#        例如  release/win64/mods/easy_mode.mod
#  所有以 # 开头的行都是注释，会被游戏忽略。
# ============================================================

# 全局倍率：金币 x3，经验 x2
mult coins=3 xp=2

# 商店道具价格打折（原价：ROD 30 / LURE 40 / NET 50 / BOAT 150）
shop ROD cost=15
shop LURE cost=20
shop NET cost=25
shop BOAT cost=75