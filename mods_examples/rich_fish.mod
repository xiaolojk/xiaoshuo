# ============================================================
#  PixelLakeHeart 示例 Mod：暴富钓鱼 rich_fish
#  ------------------------------------------------
#  把每种鱼都改得很值钱，钓上来直接发财。
#
#  语法：fish <编号0-9> value=售价 exp=经验 weight=参考重量 diff=难度0-4
#  鱼编号对照：
#    0 鲤鱼 CARP          1 鲈鱼 PERCH
#    2 银鲤 SILVER CARP   3 鲶鱼 CATFISH
#    4 大口鲈 LARGEMOUTH  5 蓝鳃鱼 BLUEGILL
#    6 鲑鱼 SALMON        7 金鳟 GOLD TROUT
#    8 电鳗 ELECTRIC EEL  9 湖龙 LAKE DRAGON
# ============================================================

fish 0 value=300 exp=10 weight=52 diff=0
fish 1 value=500 exp=10 weight=46 diff=0
fish 2 value=900 exp=20 weight=34 diff=1
fish 3 value=1200 exp=20 weight=28 diff=1
fish 4 value=1400 exp=20 weight=26 diff=1
fish 5 value=2200 exp=30 weight=16 diff=1
fish 6 value=3000 exp=40 weight=18 diff=2
fish 7 value=4000 exp=40 weight=12 diff=2
fish 8 value=5500 exp=50 weight=9  diff=3
fish 9 value=15000 exp=80 weight=5 diff=3